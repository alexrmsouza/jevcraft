# ---- Required: one model key and a Minecraft server ------------------------

# Jev through TypeSafe. Get a key at https://typesafe.ai/
TYPESAFE_API_KEY=

# The Minecraft Java 26.1 server the bot joins, and the name it plays as.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Jev
# "offline" for a LAN/offline-mode server, "microsoft" for a real account.
MC_AUTH=offline

# ---- Local language and narration (all interpreter modes) -----------------
# Defaults: en-US and full. Saved in-game choices override these defaults.
# JEV_LANGUAGE=pt-BR
# JEV_NARRATION=full
# Supported: JEV_LANGUAGE=en-US|pt-BR; JEV_NARRATION=off|important|full.
# Local controls: !jev language pt-BR; !jev narration important.
# off: direct replies only. important: also dangers, failures and completion.
# full: also startup greetings and task progress. No extra model calls.
# Mutations use JEV_CHAT_ADMINS below, or the sole other loopback player.

# ---- Personality and conversation initiative ------------------------------
# Saved in-game choices override these defaults. All configuration is English.
# JEV_PERSONALITY=companion
# reserved: brief and calm; companion: cooperative and curious;
# playful: light situational humor. Personality never changes safety/permissions.
# JEV_INITIATIVE=help
# off: answer players only; help: also ask for help with blocked tasks;
# full: also offer useful next steps after observed events (requires full narration).
# Local controls: !jev personality playful; !jev initiative full.
# Narration off suppresses automatic questions; direct clarifications still work.
# Conversations and questions persist locally, separately by world and player.
# Use MC_WORLD_ID when changing the world at an existing server address.
# Local memory controls: !jev memory; !jev memory clear (your own memory only).
# Say "Jev remember that our base is beside the river" to save a lasting note.

# ---- Player-like perception, actions and cooperation ----------------------
# Connection-scoped settings: restart the bot after changing these values.
# JEV_PERCEPTION=player
# player: visible/remembered terrain and entities only; unrestricted: legacy data.
# JEV_COORDINATES=hud
# hud: F3-like coordinates; relative: direction/distance; off: no coordinates.
# JEV_ACTIONS=natural
# natural: gradual camera rotation and player reach; unrestricted: legacy actions.
# JEV_COOPERATION=ask
# ask: confirm other-player task replacement, building edits and shared containers.
# off: restore the previous permission-free cooperation behavior.
# Player-mode goal/world/resource state is separate from unrestricted state;
# older oracle-derived terrain is not imported. Existing files/items are retained.
# MC_LOADER=vanilla
# Supported configuration: vanilla or vanilla-compatible Fabric networking only.
# Forge/NeoForge/custom content require a versioned client/content adapter.
# Run npm run compatibility for a local report; it does not connect to a server.

# ---- Optional: ChatGPT high-level planner ---------------------------------
# Run npm run chatgpt:login and npm run chatgpt:verify before enabling.
# Jev still needs its model key for tactical decisions and execution.
# JEV_PLANNER=chatgpt
# CHATGPT_MODEL=gpt-6-luna
# Without CHATGPT_MODEL, use the first visible model in your account catalog.
# CHATGPT_TIMEOUT_MS=45000
# JEV_PLANNER=jev restores the original request interpreter.
# ChatGPT chat mode: open, named, or auto. When unset, loopback servers use
# open; other servers use auto (one other player: open; two or more: named).
# JEV_CHAT_MODE=auto
# An explicit JEV_CHAT_MODE fixes the mode; leave unset for chat overrides.
# Players allowed to change settings with !jev chat open|named|auto,
# !jev language en-US|pt-BR, !jev narration off|important|full,
# !jev personality reserved|companion|playful, or !jev initiative off|help|full.
# When empty, only a sole other player on a loopback server may change it.
# JEV_CHAT_ADMINS=YourMinecraftName

# ---- Optional: generative model for custom building designs and stuck recovery

# Creative mode only. With it, "Jev build a cherry mansion" in Creative gets a
# custom design; in Survival, or without it, Jev configures building templates.
OPENROUTER_API_KEY=
OPENROUTER_BUILD_MODEL=anthropic/claude-opus-5.5
# auto: custom designs in Creative when a key is set, templates otherwise.
# jev: always templates. openrouter: require custom designs in Creative.
# Survival always uses templates.
BUILD_DESIGNER=auto
# jev: Jev picks a code-checked recovery action after repeated failures.
# off: ordinary retries only.
RECOVERY_ADVISER=jev

# ---- Optional: everything else ---------------------------------------------

# Jev decisions can also go through OpenRouter instead of TypeSafe.
# JEV_PROVIDER=typesafe
# JEV_PROVIDER=openrouter
# OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Pin the protocol version if auto-detection picks the wrong one.
# MC_VERSION=26.1
# A separate memory namespace when you replace the world at the same address.
# MC_WORLD_ID=my-survival-world

# Players allowed to ask for server commands ("Jev make it daytime").
# Empty disables them. The bot also needs operator permission on the server.
MC_COMMAND_USERS=

# The bot records what it sees and decides to .bot-state/flight (kept a day)
# for the audits; set to 0 to turn that off.
# JEV_FLIGHT=1

# Development drills (scripts/arena.js, terrain.js, endgame.js): a player the
# drill puts in Spectator on the bot so a run can be watched. Leave empty to
# watch nothing.
# ARENA_WATCHER=YourPlayerName

# Trials: the player made an operator on every trial server, to spectate Jev.
# TRIAL_WATCHER=YourPlayerName
# Optional client recordings for death-camera/replay tools. Auto-detection tries
# the PrismLauncher "Jev Replays" instance, then the vanilla Minecraft folder:
# Windows: %APPDATA%/PrismLauncher/instances/Jev Replays/.minecraft/replay_recordings
# macOS: ~/Library/Application Support/PrismLauncher/instances/Jev Replays/minecraft/replay_recordings
# Linux: ${XDG_DATA_HOME:-~/.local/share}/PrismLauncher/instances/Jev Replays/.minecraft/replay_recordings
# Set an absolute path for another launcher/instance. No client is needed for reports.
# REPLAY_RECORDINGS=/path/to/replay_recordings
# Local trial tools default to <repo>/.tools; --tools PATH overrides this value.
# JEV_TOOLS=C:/path/to/jev-tools
