#!/bin/sh
# Optional Unix wrapper. Windows and Unix can start the launcher directly:
#   node scripts/server/start.js --directory .clean-run
# Copy beside server.jar as start.sh only for an existing Unix workflow.
# Configure Java/JAR/JVM arguments in server-launch.json; JAVA and SERVER_JAR
# override its saved paths. The launcher owns Java's stdin on every platform.
# Commands go through scripts/lib/server.writeConsole (not a named pipe).
SERVER=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
ROOT=${JEVCRAFT_ROOT:-$(dirname "$SERVER")}
exec node "$ROOT/scripts/server/start.js" --directory "$SERVER" "$@"
