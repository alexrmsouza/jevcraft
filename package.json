{
  "name": "jevcraft",
  "version": "0.1.0",
  "private": true,
  "description": "A Minecraft bot whose every judgment, from what a chat message means to when to fight or shelter, is a typed answer from TypeSafe's Jev decision model",
  "license": "MIT",
  "author": "Matt Rubens",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrubens/jevcraft.git"
  },
  "homepage": "https://github.com/mrubens/jevcraft#readme",
  "bugs": {
    "url": "https://github.com/mrubens/jevcraft/issues"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "typesafe",
    "jev",
    "decision-model",
    "ai"
  ],
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "chatgpt:login": "node scripts/chatgpt.js login",
    "chatgpt:status": "node scripts/chatgpt.js status",
    "chatgpt:models": "node scripts/chatgpt.js models",
    "chatgpt:verify": "node scripts/chatgpt.js verify",
    "chatgpt:logout": "node scripts/chatgpt.js logout",
    "plan": "node scripts/try-plan.js",
    "live": "node scripts/live-test.js",
    "pretest": "node scripts/check-node.js",
    "test": "node scripts/test.js",
    "accept": "node scripts/acceptance.js",
    "build-followup": "node scripts/build-followup-test.js",
    "skin": "node scripts/create-robot-skin.js",
    "trial": "node scripts/trials/cli.js",
    "server": "node scripts/server/start.js",
    "check:portability": "node scripts/check-portability.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "minecraft-data": "^3.0.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10"
  }
}
